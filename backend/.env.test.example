# Cấu hình cho `npm test`. Copy thành .env.test (file này KHÔNG được commit).
#
# Test integration tạo user/profile/token thật rồi xoá đi, nên PHẢI trỏ vào một
# DB cục bộ dùng riêng — tuyệt đối không dùng lại DATABASE_URL của .env
# (Supabase production). tests/setup-env.js sẽ chặn cứng nếu thấy "supabase".
#
# Dựng DB test một lần. Không cần sudo: dùng một SCHEMA riêng trong database mà
# user Postgres của máy đã sở hữu, nên bảng test nằm tách biệt hoàn toàn với dữ
# liệu sẵn có ở schema public.
#   psql -d my_project -c "create schema if not exists kidfun_test;"
#   cd backend && npx prisma db push      # dựng bảng vào schema đó
#
# Chuỗi kết nối dưới đây dùng unix socket + peer auth nên không cần mật khẩu.
# Đổi "khanh" thành user Postgres của máy nếu khác.
DATABASE_URL="postgresql://khanh@localhost/my_project?host=/var/run/postgresql&schema=kidfun_test"
DIRECT_URL="postgresql://khanh@localhost/my_project?host=/var/run/postgresql&schema=kidfun_test"

NODE_ENV=test
PORT=3101

JWT_SECRET=test-only-secret-khong-dung-o-dau-khac
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
