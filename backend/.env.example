# Environment
NODE_ENV=development

# Backend Server
PORT=3001
HOST=0.0.0.0
API_URL=http://localhost:3001

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-x-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-x-region.pooler.supabase.com:5432/postgres"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URLs
PARENT_DASHBOARD_URL=http://localhost:3000
CHILD_MONITOR_URL=http://localhost:3002

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# SMTP (Gmail App Password)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Firebase (place firebase-service-account.json in backend/)
# Or set FIREBASE_SERVICE_ACCOUNT env var in production

# Supabase Storage (SOS audio uploads — see backend/src/utils/supabaseStorage.js)
# Project Settings → API → Project URL / service_role key (NOT the anon key —
# uploading to a private bucket needs the service role key).
# Create a private bucket named "sos-audio" in Storage before first use.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Realtime auth (see backend/src/utils/realtimeAuth.js)
# Project Settings → API → JWT Secret. Different from JWT_SECRET above —
# this is Supabase's own secret, needed so Realtime accepts our custom JWTs
# for RLS. See docs/supabase-realtime-rls.sql for the matching RLS policies.
SUPABASE_REALTIME_JWT_SECRET=

# Vercel Cron (only needed when deploying to Vercel — see backend/vercel.json)
# Vercel auto-sends this as `Authorization: Bearer $CRON_SECRET` on cron requests.
# Generate a random value, e.g.: openssl rand -hex 32
CRON_SECRET=
